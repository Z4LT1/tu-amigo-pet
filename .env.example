# Base de datos PostgreSQL.
# Local: `npx prisma dev` entrega una URL postgres://localhost:...
# Producción: cadena de conexión de Neon (u otro Postgres administrado)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# URL pública del sitio (usada en SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secreto para firmar la sesión del panel de administración (mín. 32 caracteres)
AUTH_SECRET="cambia-este-valor-por-uno-aleatorio-de-32-caracteres"

# Usuario administrador inicial creado por el seed
ADMIN_EMAIL="admin@tuamigopet.cl"
ADMIN_PASSWORD="cambiar-esta-clave"
